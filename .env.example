# 테스트 워크스페이스의 앱 설정 값을 로컬 .env에 입력하세요. 채팅·Git에 공유하지 않습니다.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APP_ID=
SLACK_TEAM_ID=
# URL이 아닌 hostname: my-workspace.slack.com
SLACK_WORKSPACE_HOST=
# 비워두면 D-HWP를 초대한 채널에서 자동으로 활성화됩니다.
# 선택: 최초 DB 생성 시 미리 활성화할 채널 ID. 이후 App Home 설정이 우선합니다.
SLACK_CHANNEL_IDS=
# editor·studio와 Slack 수신기를 함께 제공할 HTTPS origin (경로 제외)
APP_ORIGIN=
# 선택: 별도 Pages에서 호스트·Studio를 제공할 때만 정확한 HTTPS origin 지정
# 미설정 시 APP_ORIGIN 사용. 와일드카드·임의 preview 도메인 금지.
EDITOR_ORIGIN=
PORT=3000

# 로컬 기본은 127.0.0.1. 컨테이너는 compose에서 0.0.0.0으로 설정합니다.
HOST=127.0.0.1

# 문서/채널 연결 DB. 원본 bytes와 편집 세션은 저장하지 않습니다.
STATE_DB_PATH=.data/state.sqlite
# 채널 설정을 변경할 앱 관리자 Slack 사용자 ID, 쉼표 구분
SLACK_ADMIN_USER_IDS=
# Slack에서 reactions:write 권한을 승인/재설치한 후 true
SLACK_REACTIONS_ENABLED=false

# D-HWP MCP 선택 설정. 로컬 작업실은 .env.desk.local에서 같은 항목을 읽습니다.
# stdio(command/args) 또는 원격 URL 중 하나만 지정합니다. 인증정보는 Git에 넣지 않습니다.
DHWP_RULES_MCP_COMMAND=
DHWP_RULES_MCP_ARGS=
DHWP_RULES_MCP_URL=
DHWP_RULES_MCP_TOKEN=
# 내부 자료 접근 범위를 확인한 운영자만 필요한 경로를 활성화합니다.
DHWP_RULES_FINANCE_ENABLED=false
DHWP_RULES_SLACK_ENABLED=false
