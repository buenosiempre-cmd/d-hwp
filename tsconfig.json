{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src/assistant/**/*.ts",
    "src/desk/**/*.ts",
    "src/shared/**/*.ts",
    "studio/adapters/**/*.ts",
    "src/editor/**/*.ts"
  ]
}
