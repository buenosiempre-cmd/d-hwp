{
  "display_information": {
    "name": "D-HWP 동국 한글문서 도우미",
    "description": "한글 문서를 PDF·PNG·TXT·Markdown·선택 쪽 ZIP으로 변환하는 동국대학교 CoP 시제품",
    "background_color": "#b85022"
  },
  "features": {
    "bot_user": {
      "display_name": "D-HWP",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/dhwp",
        "url": "https://example.invalid/slack/events",
        "description": "한글 문서 변환: PDF·PNG·Markdown, 카드에서 TXT·선택 쪽 ZIP",
        "usage_hint": "pdf|png|md <Slack 파일 링크> 또는 help",
        "should_escape": true
      }
    ],
    "shortcuts": [
      {
        "name": "동국 한글문서 변환",
        "type": "message",
        "callback_id": "rhwp_open_document",
        "description": "HWP/HWPX를 PDF·PNG·TXT·Markdown·선택 쪽 ZIP으로 변환"
      }
    ],
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "commands",
        "chat:write",
        "files:read",
        "channels:read",
        "groups:read",
        "files:write",
        "app_mentions:read",
        "reactions:write"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://example.invalid/slack/events",
      "bot_events": [
        "file_deleted",
        "file_unshared",
        "entity_details_requested",
        "file_shared",
        "app_mention",
        "app_home_opened",
        "member_joined_channel"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://example.invalid/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
